# Xiaomi Mi 11T Pro (vili) fragment, applied on top of new_defconfig:
#   make O=output new_defconfig vili.config

# Display: k3s DSC panel built in so it probes before the DPU binds
CONFIG_DRM_PANEL_XIAOMI_K3S=y
# DPU/DSI need the interconnect provider at probe time
CONFIG_INTERCONNECT_QCOM_SM8350=y
# Adreno 660: GPU clock controller (also needed by the GPU SMMU)
CONFIG_SM_GPUCC_8350=y
# DSI/DSI PHY take refgen-supply since 6.10; without it msm_dsi defers forever
CONFIG_REGULATOR_QCOM_REFGEN=y

# Touch: ST FTS over SPI
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_INPUT_UINPUT=y

# Other panels, built as modules (not used by vili)
CONFIG_DRM_PANEL_BOE_TV101WUM_NL6=m
CONFIG_DRM_PANEL_EDP=m
CONFIG_DRM_PANEL_ILITEK_ILI9882T=m
CONFIG_DRM_PANEL_LVDS=m
CONFIG_DRM_PANEL_MANTIX_MLAF057WE51=m
CONFIG_DRM_PANEL_RAYDIUM_RM67191=m
CONFIG_DRM_PANEL_SIMPLE=m
CONFIG_DRM_PANEL_SITRONIX_ST7703=m
CONFIG_DRM_PANEL_TRULY_NT35597_WQXGA=m
CONFIG_DRM_PANEL_VISIONOX_VTDR6130=m

# Android ABL boots a raw gzip Image; EFI zboot makes the default image
# (and bindeb-pkg's vmlinuz) a PE/EFI executable instead of Image.gz
# CONFIG_EFI_ZBOOT is not set

# Wi-Fi/BT: QCA6490 (WCN6855 family) on PCIe0 and UART18, powered by the
# WCN6855 PMU power sequencer. Built in so it works from the initramfs.
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_BT_HIDP=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y

# Audio: CS35L41 speaker amps on TDM
CONFIG_SND_SOC_CS35L41_I2C=m

# Voice calls through the QDSP6 voice services
CONFIG_SND_SOC_QDSP6_Q6VOICE=m

# Camera clock controller, camera PMIC and sensors
CONFIG_SM_CAMCC_8350=m
CONFIG_MFD_QCOM_PM8008=m
CONFIG_REGULATOR_QCOM_PM8008=m
CONFIG_VIDEO_IMX355=m

# EROFS: Android's vendor/odm partitions (in super) are LZ4-compressed EROFS.
# Built in so droid-juicer's mount, which tries the types in
# /proc/filesystems, can mount them without a module being loaded first.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
